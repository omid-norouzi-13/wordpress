<?php
// حذف کامل محاسبات ارسال از سبد خرید و تسویه‌حساب
add_filter( 'woocommerce_cart_ready_to_calc_shipping', 'disable_shipping_calculation' );
function disable_shipping_calculation( $calc_shipping ) {
    return false;
}

// حذف ردیف هزینه ارسال از جمع‌بندی سبد خرید
add_filter( 'woocommerce_cart_shipping_method_full_label', 'remove_shipping_label', 10, 2 );
function remove_shipping_label( $label, $method ) {
    return '';
}

// مخفی کردن بخش ارسال در صفحه تسویه‌حساب
add_action( 'wp_head', 'hide_shipping_section_css' );
function hide_shipping_section_css() {
    if ( is_checkout() || is_cart() ) {
        echo '<style>
            .woocommerce-shipping-totals,
            .shipping,
            .shipping__destination,
            .shipping-calculator,
            .shipping-calculator-form,
            .woocommerce-shipping-calculator,
            #shipping_method,
            .shipping_method {
                display: none !important;
            }
        </style>';
    }
}
